# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/
/build

# Tests and coverage
/coverage

# Environment files (keep example templates)
.env*
!.env.example
!.env.*.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Certificates and OS files
*.pem
.DS_Store
Thumbs.db

# VS Code: ignore workspace files, keep shared project settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# JetBrains IDEs: IntelliJ IDEA, WebStorm, etc.
.idea/
*.iml

